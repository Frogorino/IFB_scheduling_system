{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start IFB scheduling server",
            "type": "shell",
            "command": "npm.cmd",
            "args": [
                "start"
            ],
            "options": {
                "env": {
                    "PORT": "3001"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "ifb-scheduling-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> ifb-scheduling-system@",
                    "endsPattern": "^Server running on port 3001$"
                }
            },
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1
            }
        }
    ]
}
